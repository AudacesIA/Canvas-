# Porta do daemon. O MCP procura o daemon aqui antes de tentar subir um.
AUDASYS_PORT=8787

# Onde ficam os dados dos clientes. Default: <repo>/data
# AUDASYS_DATA_DIR=/Users/alexandresilveira/dev/audasys-canvas/data

# Geração de cenários por IA (Gemini). Sem ela, criar cenário produz o clone
# fiel do processo e AVISA que a remontagem não saiu — não existe gerador
# local de reserva, e isso é deliberado: o antigo inventava as mudanças.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# ── Acesso ───────────────────────────────────────────────────────────────────
# Assina os cookies de sessão. Sem ela o servidor RECUSA subir — de propósito.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# AUDASYS_SECRET=
# O que você cola em /entrar.html. Sem ela, não existe acesso de administrador.
# AUDASYS_ADMIN_KEY=
# Credencial do servidor MCP, que não tem navegador para carregar cookie.
# AUDASYS_SERVICE_TOKEN=
# 0.0.0.0 só em produção, atrás de proxy reverso com HTTPS. Padrão: 127.0.0.1
# AUDASYS_HOST=
